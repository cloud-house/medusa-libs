{
  "name": "@cloud-house/medusa-revalidation",
  "version": "0.0.0",
  "description": "Storefront cache revalidation for Medusa 2 shops: default event-to-tag mapping, webhook sender and a subscriber helper.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloud-house/medusa-libs.git",
    "directory": "packages/medusa-revalidation"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "keywords": [
    "medusa",
    "medusa-v2",
    "nextjs",
    "revalidation",
    "cache-tags"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloud-house/commerce-rules": "workspace:^"
  },
  "peerDependencies": {
    "@medusajs/framework": "catalog:medusa-peer"
  },
  "devDependencies": {
    "@medusajs/framework": "catalog:medusa",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "4.0.18"
  }
}
