{
  "name": "@cloud-house/medusa-content",
  "version": "0.1.2",
  "description": "Medusa plugin: editorial content – pages, articles, header/footer/home page and shop-defined kinds, with drafts, versions, references, handle history, media and a Lexical admin editor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloud-house/medusa-libs.git",
    "directory": "packages/medusa-content"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "keywords": [
    "medusa",
    "medusa-plugin",
    "medusa-v2",
    "cms",
    "content",
    "lexical"
  ],
  "files": [
    ".medusa/server",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./.medusa/server/src/index.d.ts",
      "default": "./.medusa/server/src/index.js"
    },
    "./package.json": "./package.json",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./admin-kit": {
      "types": "./dist/admin-kit.d.ts",
      "import": "./dist/admin-kit.mjs",
      "default": "./dist/admin-kit.mjs"
    }
  },
  "scripts": {
    "build": "medusa plugin:build && tsup && cp dist/admin-kit.d.mts dist/admin-kit.d.ts",
    "dev": "medusa plugin:develop",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm run test:unit && pnpm run test:integration:modules",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit --passWithNoTests"
  },
  "dependencies": {
    "@cloud-house/commerce-rules": "workspace:^",
    "@lexical/headless": "0.50.0",
    "@lexical/history": "0.50.0",
    "@lexical/link": "0.50.0",
    "@lexical/list": "0.50.0",
    "@lexical/react": "0.50.0",
    "@lexical/rich-text": "0.50.0",
    "@lexical/selection": "0.50.0",
    "@lexical/utils": "0.50.0",
    "lexical": "0.50.0",
    "multer": "2.4.0",
    "sharp": "0.35.4"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "catalog:medusa-peer",
    "@medusajs/framework": "catalog:medusa-peer",
    "@medusajs/icons": "catalog:medusa-peer",
    "@medusajs/js-sdk": "catalog:medusa-peer",
    "@medusajs/medusa": "catalog:medusa-peer",
    "@medusajs/ui": "catalog:medusa-peer",
    "@tanstack/react-query": "catalog:medusa-peer",
    "react": "catalog:medusa-peer"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "catalog:medusa",
    "@medusajs/cli": "catalog:medusa",
    "@medusajs/framework": "catalog:medusa",
    "@medusajs/icons": "catalog:medusa",
    "@medusajs/js-sdk": "catalog:medusa",
    "@medusajs/medusa": "catalog:medusa",
    "@medusajs/test-utils": "catalog:medusa",
    "@medusajs/ui": "catalog:medusa",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@tanstack/react-query": "catalog:medusa",
    "@types/jest": "^29.5.13",
    "@types/multer": "2.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22.22.0 <25"
  }
}
