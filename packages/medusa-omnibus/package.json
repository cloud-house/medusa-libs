{
  "name": "@cloud-house/medusa-omnibus",
  "version": "0.1.2",
  "description": "Medusa plugin: price history for the Omnibus directive (lowest price in the 30 days before a reduction), recorded hourly.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloud-house/medusa-libs.git",
    "directory": "packages/medusa-omnibus"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "keywords": [
    "medusa",
    "medusa-plugin",
    "medusa-v2",
    "omnibus",
    "price-history"
  ],
  "files": [
    ".medusa/server"
  ],
  "exports": {
    ".": {
      "types": "./.medusa/server/src/index.d.ts",
      "default": "./.medusa/server/src/index.js"
    },
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm run test:unit && pnpm run test:integration:modules",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit --passWithNoTests"
  },
  "peerDependencies": {
    "@medusajs/framework": "catalog:medusa-peer",
    "@medusajs/medusa": "catalog:medusa-peer"
  },
  "devDependencies": {
    "@medusajs/cli": "catalog:medusa",
    "@medusajs/framework": "catalog:medusa",
    "@medusajs/medusa": "catalog:medusa",
    "@medusajs/test-utils": "catalog:medusa",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^24.0.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22.22.0 <25"
  },
  "dependencies": {
    "@cloud-house/commerce-rules": "workspace:^"
  }
}
