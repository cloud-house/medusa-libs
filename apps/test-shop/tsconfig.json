{
  "compilerOptions": {
    "target": "ES2021",
    "esModuleInterop": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "types": ["node", "jest"]
  },
  "include": ["**/*"],
  "exclude": ["node_modules", ".medusa"]
}
